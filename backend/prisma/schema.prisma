generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x : moteur utilisé par les fonctions Netlify (AWS Lambda)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  customer
  business
}

enum BusinessStatus {
  pending
  active
  inactive
}

enum SiteStatus {
  draft
  preview
  live
}

enum PaymentStatus {
  pending
  paid
  canceled
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique @db.VarChar(255)
  password_hash String        @db.VarChar(255)
  first_name    String?       @db.VarChar(100)
  last_name     String?       @db.VarChar(100)
  role          Role          @default(customer)
  credits       Int           @default(3000)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  last_login    DateTime?
  businesses    Business[]
  templates     Template[]
  sites         Site[]
  credit_log    CreditEntry[]
  preview       DraftPreview?

  @@map("users")
}

model Template {
  id            Int      @id @default(autoincrement())
  key           String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  category      String   @db.VarChar(100)
  industry      String   @db.VarChar(100)
  description   String?
  thumbnail_url String?  @db.VarChar(500)
  price         Decimal  @default(0) @db.Decimal(10, 2)
  features      Json?
  languages     Json?
  created_at    DateTime @default(now())
  created_by    Int?
  creator       User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([created_by])
  @@map("templates")
}

model Business {
  id          Int            @id @default(autoincrement())
  user_id     Int
  name        String         @db.VarChar(255)
  industry    String?        @db.VarChar(100)
  address     String?        @db.VarChar(500)
  phone       String?        @db.VarChar(50)
  email       String?        @db.VarChar(255)
  website_url String?        @db.VarChar(500)
  status      BusinessStatus @default(pending)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  owner       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("businesses")
}

model Site {
  id                 Int           @id @default(autoincrement())
  user_id            Int
  name               String        @db.VarChar(255)
  slug               String        @unique @db.VarChar(100)
  template_key       String        @db.VarChar(50)
  lang               String        @default("fr") @db.VarChar(5)
  content            Json
  source             Json?
  status             SiteStatus    @default(draft)
  preview_expires_at DateTime?
  published_at       DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  owner              User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_links      PaymentLink[]

  @@index([user_id])
  @@map("sites")
}

model PaymentLink {
  id            Int           @id @default(autoincrement())
  site_id       Int
  token         String        @unique @db.VarChar(64)
  setup_cents   Int
  monthly_cents Int
  status        PaymentStatus @default(pending)
  fee_cents     Int           @default(0)
  payout_cents  Int           @default(0)
  paid_at       DateTime?
  created_at    DateTime      @default(now())
  site          Site          @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@index([site_id])
  @@map("payment_links")
}

model CreditEntry {
  id         Int      @id @default(autoincrement())
  user_id    Int
  delta      Int
  reason     String   @db.VarChar(100)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("credit_entries")
}

/// Aperçu du brouillon en cours d'édition (un par utilisateur) : l'API est sans état, donc il vit en base
model DraftPreview {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  token      String   @unique @db.VarChar(64)
  html       String
  pack       Boolean  @default(false)
  expires_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("draft_previews")
}
