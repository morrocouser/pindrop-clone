PORT=3000
NODE_ENV=development
# Origines autorisées, séparées par des virgules
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://username:password@localhost:5432/pindrop
# Obligatoire : générer avec `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
BCRYPT_ROUNDS=10
PUBLIC_BASE_URL=http://127.0.0.1:3000
# test = paiements simulés (aucun débit réel)
PAYMENTS_MODE=test
# En production, le paiement simulé est coupé (il permettrait une mise en ligne gratuite). true = le garder (démo).
# ALLOW_TEST_PAYMENTS=false
# En-tête portant l'adresse réelle du client (limitation de débit), posé par l'hébergeur.
# Vide en local ; détecté seul sur Netlify (x-nf-client-connection-ip). Jamais X-Forwarded-For.
# CLIENT_IP_HEADER=
# IA (OmniRoute) : lancer `omniroute serve`, connecter un fournisseur dans le tableau de bord
# (http://localhost:20128), puis copier ici la clé créée dans Dashboard > Endpoints.
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
